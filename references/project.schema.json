{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 45
    },
    "project_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 26
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "institution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 18
        },
        "patent_type": {
          "enum": [
            "发明专利",
            "实用新型专利",
            "外观设计专利",
            "专利申请",
            "技术成果"
          ]
        },
        "patent_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "institution",
        "patent_type",
        "patent_number",
        "source_id"
      ]
    },
    "maturity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 26
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "label",
        "source_id"
      ]
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 22
        },
        "phone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      },
      "required": [
        "label",
        "source_id"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "id",
          "title",
          "location",
          "locator"
        ]
      },
      "minItems": 1,
      "maxItems": 20
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "id",
          "claim",
          "source_id",
          "locator"
        ]
      },
      "minItems": 1,
      "maxItems": 40
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "rate": {
          "type": "string",
          "pattern": "^[+-][0-9]{1,2}%$"
        }
      },
      "required": [
        "name",
        "rate"
      ]
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "credit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        }
      },
      "required": [
        "path",
        "credit"
      ]
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headline": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 13
          },
          "minItems": 2,
          "maxItems": 3
        },
        "visual": {
          "enum": [
            "flow",
            "compare",
            "sensor",
            "thermal",
            "separation",
            "material",
            "cards",
            "image",
            "mri",
            "custom"
          ]
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "scene_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,25}$"
        },
        "time": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        }
      },
      "required": [
        "headline",
        "visual"
      ]
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,25}$"
          },
          "headline": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 18
            },
            "minItems": 1,
            "maxItems": 2
          },
          "narration": {
            "type": "string",
            "minLength": 1,
            "maxLength": 140
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "minItems": 1,
            "maxItems": 10
          },
          "visual": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "flow",
                  "compare",
                  "sensor",
                  "thermal",
                  "separation",
                  "material",
                  "cards",
                  "image",
                  "cta",
                  "mri",
                  "custom"
                ]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 22
                },
                "minItems": 1,
                "maxItems": 5
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 18
                },
                "minItems": 1,
                "maxItems": 2
              },
              "mode": {
                "enum": [
                  "oil_pass",
                  "water_pass",
                  "hotspot",
                  "coil",
                  "acquisition",
                  "training",
                  "iteration",
                  "reconstruction",
                  "application"
                ]
              },
              "footer": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 36
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "demonstration": {
                "type": "string",
                "minLength": 12,
                "maxLength": 250
              },
              "motion_region": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 985
                },
                "minItems": 4,
                "maxItems": 4
              },
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,30}$"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "id",
          "headline",
          "narration",
          "evidence_ids",
          "visual"
        ]
      },
      "minItems": 4,
      "maxItems": 8
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "facts_checked": {
          "type": "boolean"
        },
        "visual_meaning_checked": {
          "type": "boolean"
        }
      },
      "required": [
        "facts_checked",
        "visual_meaning_checked"
      ]
    },
    "closing_lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 18
      }
    },
    "animation_script": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  },
  "required": [
    "schema_version",
    "title",
    "project_number",
    "tagline",
    "audience",
    "identity",
    "maturity",
    "sources",
    "facts",
    "voice",
    "music",
    "cover",
    "scenes",
    "review"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
